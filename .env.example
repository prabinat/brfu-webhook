# Set to your own HTTPS Cloudflare Tunnel origin (no path/trailing slash)
PUBLIC_BASE_URL=https://replace-with-your-tunnel.example.com
# BRFU-UAT subaccount token only. NEVER commit your real value.
TWILIO_AUTH_TOKEN=REPLACE_WITH_BRFU_UAT_AUTH_TOKEN
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_TOKEN=REPLACE_WITH_LONG_RANDOM_ADMIN_TOKEN
